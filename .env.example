# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_IMAGES_BUCKET=listing-images

# GOWA (self-hosted WhatsApp REST API) — deploy this as its OWN Railway
# service using the official template, separate from this app:
# https://railway.com/deploy/gowa-whatsapp-web-multidevice
GOWA_BASE_URL=https://your-gowa-service.up.railway.app
GOWA_BASIC_AUTH_USER=admin
GOWA_BASIC_AUTH_PASS=set-a-strong-password

# Output image size in pixels (square). All accepted listing photos are
# center-cropped and resized to this exact size.
LISTING_IMAGE_SIZE=1000

# Max original upload size accepted, in megabytes, before processing.
MAX_UPLOAD_MB=10

# Bare phone numbers (comma-separated, no "@s.whatsapp.net") allowed to run
# the APPROVE admin command from WhatsApp. Usually just the middleman.
ADMIN_PHONES=2348012345678
